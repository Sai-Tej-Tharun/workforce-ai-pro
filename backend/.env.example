# --- Database (MySQL is the primary target) ---
DATABASE_URL=mysql+pymysql://root:tarun123@localhost:3306/workforce_ai?charset=utf8mb4
# For a zero-setup local demo use SQLite instead:
# DATABASE_URL=sqlite:///./workforce_ai.db

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
RESET_TOKEN_MINUTES=30
# Dev only: return the reset token in the API response (no email server in this project)
EXPOSE_RESET_TOKEN=true

# --- App ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HIGH_RISK_THRESHOLD=0.60
MEDIUM_RISK_THRESHOLD=0.30
MAX_UPLOAD_MB=10
